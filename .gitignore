# Xcode local state and generated build products
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcresult/
DerivedData/
DerivedData*/
**/DerivedData/
**/DerivedData*/
**/ModuleCache.noindex/
**/CompilationCache.noindex/
**/Index.noindex/
build/
**/build/

# Swift Package Manager local state and generated dependencies
.build/
**/.build/
**/.build*/
.swiftpm/
**/SourcePackages/checkouts/
**/SourcePackages/repositories/
Package.resolved
# Exception: core/Package.resolved is committed to pin duckduckgo/GRDB.swift to a
# specific revision that compiles cleanly on macOS and Linux (see core/Package.swift).
!core/Package.resolved

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# OS
**/.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude — ignore runtime/session state, but track committed agent definitions.
# Note: exclude the *contents* of .claude/ (not the dir itself) so the
# negation for .claude/agents/ can take effect (git won't descend into an
# excluded directory).
.claude/*
!.claude/agents/

# Paperclip runtime state
.paperclip/
.paperclip-sync/

# Secrets — never commit these
.env
.env.*
credentials.json
token.json

# Temporary files
.tmp/
/artifacts/
__pycache__/
**/__pycache__/
*.py[cod]

# Logs
*.log

# Backups
backups/

# AUTO GO + HUNT FIX + GITHUB FLOW heartbeat state (local run state, not project history)
docs/auto-go-heartbeat.md
docs/hunt-fix-heartbeat.md
docs/github-flow-heartbeat.md
docs/auto-go-heartbeat.md.bak
docs/hunt-fix-heartbeat.md.bak
docs/github-flow-heartbeat.md.bak

# GitHub issue fisher run outputs are operational evidence, not source.
docs/github-issue-fisher/*
!docs/github-issue-fisher/.gitkeep

# Agent/tooling junk that has appeared at the repo root (2026-07-02 audit) —
# ignore so the artifact guard's tracked-file check stays the only gate needed.
=
[object Object]/
.playwright-mcp/
docs/testing/artifacts/
.worktrees/
